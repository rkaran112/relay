# Copy to .env and adjust.

# SQLAlchemy-style URL (the +psycopg driver). Alembic reads this directly; the
# runtime queue code strips the +psycopg prefix to get a native psycopg DSN.
DATABASE_URL=postgresql+psycopg://relay:relay@localhost:5432/relay

# Tests run against this DB so they never touch your dev data. Created automatically
# by the test fixture if it doesn't exist. Falls back to DATABASE_URL when unset.
TEST_DATABASE_URL=postgresql+psycopg://relay:relay@localhost:5432/relay_test

# Redis (outbox publisher target, wired up in Phase 5).
REDIS_URL=redis://localhost:6379/0
